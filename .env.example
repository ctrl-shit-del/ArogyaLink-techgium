# ============================================================
# SYNERA 2.0 — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- SUPABASE (replaces PostgreSQL + ChromaDB + Redis) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
DATABASE_URL=postgresql+asyncpg://postgres.yourref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- LLM PROVIDER TOGGLE ---
# Set to "groq" for fast cloud inference (hackathon/demo)
# Set to "ollama" for local inference (DPDP compliant production)
LLM_PROVIDER=groq

# Groq (get free API key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (runs locally via: ollama serve)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- EMBEDDINGS (always local, no API key needed) ---
EMBEDDING_MODEL=BAAI/bge-m3

# --- RERANKER (always local) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- RAG CONFIG ---
RAG_TIMEOUT_SECONDS=3.0
RETRIEVAL_TOP_K_PROTOCOLS=8
RETRIEVAL_TOP_K_CASES=4
RETRIEVAL_FINAL_TOP_K=6

# --- VECTOR TABLE NAMES ---
VECTOR_TABLE_PROTOCOLS=medical_knowledge
VECTOR_TABLE_CASES=clinical_cases

# --- ALERT THRESHOLDS (do not change) ---
ARTIFACT_REJECT_HR_DELTA=40
ARTIFACT_REJECT_SPO2_DELTA=5
EXERTION_MOTION_THRESHOLD=4
EXERTION_HR_ELEVATION=15
SYNERA_STATE_SIGMA_THRESHOLD=1.5
SYNERA_STATE_MOTION_MAX=2
SYNERA_ACCELERATION_WINDOW=3

# --- APP ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=synera-dev-key-change-in-prod
